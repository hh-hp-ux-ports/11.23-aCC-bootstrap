From: HP-UX 11.23 ia64 port notes
Subject: [PATCH 6/7] toplev: SIGSEGV handler printing ia64 fault context

DIAGNOSTIC / NOT A FIX. Installs a SA_SIGINFO handler (only when GCC_BT_EXE is
set) printing si_addr, si_code, ip, gp and b0-b7. This is what showed
si_addr == ip with SEGV_MAPERR, i.e. an execute fault from a wild branch rather
than a bad data pointer -- which is how the HP ld out-of-range br.call problem
was identified. Uses __uc_get_ip/__uc_get_brs/__uc_get_grs; note HP-UX has no
__uc_get_sp (sp is r12).
--- a/gcc/toplev.c
+++ b/gcc/toplev.c
@@ -306,6 +306,40 @@
     }
 }
 
+/* DIAGNOSTIC HACK (not for shipping): on ia64-hpux the unwinder cannot step past the signal
+   frame, so libbacktrace only ever reports crash_signal itself.  Report the faulting address and
+   the interrupted instruction pointer straight out of siginfo/ucontext instead - that is what
+   identifies an invalid pointer and pinpoints where it was dereferenced.  Only installed when
+   GCC_BT_EXE is set, so the normal diagnostic path is untouched otherwise.  */
+#ifdef __hpux__
+#include <sys/uc_access.h>
+static void
+crash_siginfo (int signo, siginfo_t *si, void *uc)
+{
+  uint64_t ip = 0, brs[8], gr[2];
+  unsigned int nat = 0;
+  int i;
+  memset (brs, 0, sizeof brs);
+  memset (gr, 0, sizeof gr);
+  if (uc)
+    {
+      __uc_get_ip ((ucontext_t *) uc, &ip);
+      /* b0 is the return address of the call that went wrong: it still points into cc1plus, so
+	 addr2line can name the caller even though the IP itself is unmapped.  r1 is the GP.  */
+      __uc_get_brs ((ucontext_t *) uc, 0, 8, brs);
+      __uc_get_grs ((ucontext_t *) uc, 1, 1, gr, &nat);
+    }
+  fprintf (stderr,
+	   "\n*** SIGNAL %d  si_code=%d  si_addr=%p  ip=0x%llx  gp(r1)=0x%llx\n",
+	   signo, si ? si->si_code : -1, si ? si->si_addr : (void *) 0,
+	   (unsigned long long) ip, (unsigned long long) gr[0]);
+  for (i = 0; i < 8; i++)
+    fprintf (stderr, "*** b%d = 0x%llx\n", i, (unsigned long long) brs[i]);
+  fflush (stderr);
+  crash_signal (signo);
+}
+#endif
+
 /* Handler for fatal signals, such as SIGSEGV.  These are transformed
    into ICE messages, which is much more user friendly.  In case the
    error printer crashes, reset the signal to prevent infinite recursion.  */
@@ -1134,6 +1168,20 @@
     {
       /* Trap fatal signals, e.g. SIGSEGV, and convert them to ICE messages.  */
 #ifdef SIGSEGV
+#ifdef __hpux__
+      /* DIAGNOSTIC HACK, see crash_siginfo above.  */
+      if (getenv ("GCC_BT_EXE"))
+	{
+	  struct sigaction sa;
+	  memset (&sa, 0, sizeof sa);
+	  sa.sa_sigaction = crash_siginfo;
+	  sa.sa_flags = SA_SIGINFO;
+	  sigemptyset (&sa.sa_mask);
+	  sigaction (SIGSEGV, &sa, NULL);
+	  sigaction (SIGBUS, &sa, NULL);
+	}
+      else
+#endif
       signal (SIGSEGV, crash_signal);
 #endif
 #ifdef SIGILL
