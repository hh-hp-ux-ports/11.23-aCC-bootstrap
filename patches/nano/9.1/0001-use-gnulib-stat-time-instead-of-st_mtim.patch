From: HP-UX 11.23 port notes
Subject: [PATCH 1/2] use gnulib's stat-time module instead of raw st_mtim/st_atim

HP-UX 11.23 has no nanosecond stat timestamps at all: struct stat carries
time_t st_atime/st_mtime plus int st_spareN and no timespec member, so nano's
existing __APPLE__ hook (#define st_mtim st_mtimespec) has nothing to alias to.
Every nano from 4.9.3 to 9.1 fails to compile here.

nano already bundles gnulib's stat-time module, whose get_stat_mtime() /
get_stat_atime() return a struct timespec on every platform with or without
st_mtim. Using it is correct everywhere, needs no type punning, and is not an
HP-UX-specific hack -- so this one is upstreamable as-is.
--- a/src/files.c
+++ b/src/files.c
@@ -21,6 +21,8 @@
 
 #include "prototypes.h"
 
+#include "stat-time.h"
+
 #include <errno.h>
 #include <fcntl.h>
 #include <libgen.h>
@@ -1656,8 +1658,8 @@
 
 	/* Set the backup's timestamps to those of the original file.
 	 * Failure is unimportant: saving the file apparently worked. */
-	filetimes[0] = fileinfo.st_atim;
-	filetimes[1] = fileinfo.st_mtim;
+	filetimes[0] = get_stat_atime(&fileinfo);
+	filetimes[1] = get_stat_mtime(&fileinfo);
 	IGNORE_CALL_RESULT(futimens(descriptor, filetimes));
 
 	if (fclose(backup_file) == 0) {
--- a/src/text.c
+++ b/src/text.c
@@ -25,6 +25,8 @@
 
 #include "prototypes.h"
 
+#include "stat-time.h"
+
 #include <errno.h>
 #include <fcntl.h>
 #include <string.h>
@@ -2125,8 +2127,11 @@
 			return;
 		}
 
-		timestamp_sec = (long)fileinfo.st_mtim.tv_sec;
-		timestamp_nsec = (long)fileinfo.st_mtim.tv_nsec;
+		{
+			struct timespec mtime = get_stat_mtime(&fileinfo);
+			timestamp_sec = (long)mtime.tv_sec;
+			timestamp_nsec = (long)mtime.tv_nsec;
+		}
 	}
 
 	/* The spell checker needs the screen, so exit from curses mode. */
@@ -2180,8 +2185,8 @@
 
 	/* When the temporary file wasn't touched, say so and leave. */
 	if (timestamp_sec > 0 && stat(tempfile_name, &fileinfo) == 0 &&
-					(long)fileinfo.st_mtim.tv_sec == timestamp_sec &&
-					(long)fileinfo.st_mtim.tv_nsec == timestamp_nsec) {
+					(long)get_stat_mtime(&fileinfo).tv_sec == timestamp_sec &&
+					(long)get_stat_mtime(&fileinfo).tv_nsec == timestamp_nsec) {
 		statusline(REMARK, _("Nothing changed"));
 		return;
 	}
