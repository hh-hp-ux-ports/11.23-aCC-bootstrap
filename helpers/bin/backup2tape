#!/usr/bin/sh
# backup2tape [vg ...] [drive] [-e dir]... — Ignite recovery tape of the named volume group(s)
# (default vg00) to /dev/rmt/<drive> (default 1mn); EJECTS on success, tape stays loaded on
# failure (the failure signal). Uses -x inc_entire per VG (Ignite man page canonical form).
#   backup2tape                 -> vg00 to /dev/rmt/1mn
#   backup2tape vg00 0mn        -> vg00 to /dev/rmt/0mn
#   backup2tape vg00 vg01 -e /depots
# (bare "backup" is HP /usr/sbin/backup and helpers sit at PATH end — hence this name)
DRIVE=1mn ; VGS="" ; EX=""
while [ $# -gt 0 ] ; do
  case "$1" in
    -e) EX="$EX -x exclude=$2" ; shift ;;
    vg*) VGS="$VGS -x inc_entire=$1" ;;
    *) DRIVE=$1 ;;
  esac
  shift
done
[ -z "$VGS" ] && VGS="-x inc_entire=vg00"
DEV=/dev/rmt/$DRIVE
[ -c "$DEV" ] || { echo "no such tape device: $DEV" ; exit 1 ; }
for f in /var/tmp/ign_configure/make_sys_image_flag* ; do
  [ -f "$f" ] || continue
  if ps -ef | grep make_sys_image | grep -v grep > /dev/null ; then : ; else
    echo "removing stale ignite lock: $f" ; rm -f "$f"
  fi
done
echo "recovery tape of:$VGS -> $DEV (long run...)"
/opt/ignite/bin/make_tape_recovery -v -a $DEV $VGS $EX
rc=$?
if [ $rc -eq 0 ] ; then
  mt -t $DEV offl && echo "BACKUP OK - tape ejected."
else
  echo "BACKUP FAILED rc=$rc - tape left loaded (see /var/opt/ignite/recovery/latest/recovery.log)"
fi
exit $rc
