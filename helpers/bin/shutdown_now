#!/usr/bin/sh
# shutdown_now [-f] — HP-UX has no `shutdown now`; this is `shutdown -hy 0` (halt, no query).
# Safety: if a long build (gcc cascade/gmake/cc1) is running, refuses unless -f — a habit
# shutdown has killed an 11-hour bootstrap on this box before. build-status shows what's running.
BUSY=`ps -ef | grep -E "[g]cc_cascade_driver|[g]make|[c]c1" | wc -l`
if [ "$BUSY" -gt 0 ] && [ "$1" != "-f" ] ; then
  echo "REFUSING: $BUSY build process(es) running (see build-status). Use: shutdown_now -f"
  ps -ef | grep -E "[g]cc_cascade_driver|[g]make|[c]c1" | head -4
  exit 1
fi
exec /usr/sbin/shutdown -hy 0
