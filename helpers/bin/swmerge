#!/usr/bin/sh
# swmerge <source-depot> [<source-depot> ...] <destination-depot>
#
# Merge any number of SD depots into one, cp-style: LAST argument is the destination, everything
# before it is a source. That makes a shell glob work naturally:
#     swmerge /mnt/debianshare/3rd_party_depots/* /depots/VendorAll
#
# WHY THIS EXISTS: `swcopy -s` accepts exactly ONE source. Globbing straight into it —
#     swcopy -s /path/to/depots/* -d /dest \*
# does NOT do what it looks like: the shell expands the glob, the first path becomes -s and every
# remaining path is passed as a SOFTWARE SELECTION. This loops over the sources instead.
#
# Duplicates are handled by SD itself: recopy=false (swcopy's default, stated explicitly here) skips
# a fileset already present at the SAME version, so overlapping media sets collapse. DIFFERENT
# revisions of a product are not duplicates and are all kept.
#
# Sources may be directory depots OR serial .depot files (our own depots are all serial files);
# anything that is neither is skipped, so a bare glob over a mixed directory is safe.
#
# ⚠️ THE TARGET IS `@ <path>`, NOT `-d <path>`. `-d` is *swpackage's* destination flag; swcopy
# silently ignores it and falls back to its default target /var/spool/sw. That one misread produced
# a long chain of confusing symptoms ("it exits 0 and says Selection succeeded but nothing is at the
# destination"). Correct form, used below:
#     swcopy -s <source> '*' @ <target_depot>
#
# ⚠️ ROOT REQUIRED for an arbitrary destination. Measured 2026-07-26: as a non-root user,
# `swcopy … '*' @ /var/tmp/foo` fails outright with "You do not have the required permissions" —
# it does NOT fall back to the spool, it copies nothing. Non-root can only use the default
# /var/spool/sw target (i.e. no @ at all) and relocate afterwards with a plain filesystem copy.
#
# LICENSED (codeword-protected) SOFTWARE: HP media mixes unprotected and protected products. Without
# a codeword, swcopy copies the unprotected ones and reports an ERROR for the rest — you get a
# partial depot. Supply the pair from the CD's certificate to unlock them:
#     swmerge -c <customer_id> -k "<codeword>" /path/to/media/* /depots/All
# or via the environment:  CUSTOMER_ID=... CODEWORD="..." swmerge ...
# The codeword MUST reach swcopy as ONE argument (`-x "codeword=A B C D"`); unquoted, the shell
# splits it and the pieces become bogus software selections. This script quotes it for you.
# A codeword is tied to a CD PART NUMBER + customer id, so one pair unlocks one bundle on one disc:
# sources it does not match simply keep their protected products skipped, which is harmless here.
# Already-unlocked media need nothing — SD stores accepted codewords in /var/adm/sw/.codewords.
#
# ⚠️ NFS SOURCES ARE STAGED TO LOCAL DISK AUTOMATICALLY. Measured 2026-07-27: swcopy cannot read a
# depot that lives on the NFS share. swagentd starts the source agent and the controller then never
# contacts it —
#     * Started source agent on ".../HPUX11iv3_Apps" for root@rx2620, pid=3427, 16:40:30
#     * Agent pid=3427 timed out without being contacted by the controller ...   16:55:40
# — and swcopy fails with  ERROR: RPC exception: "Connection closed (dce / rpc)"  after exactly 15
# minutes, SD's agent idle timeout. Ruled out: permissions (the export is already no_root_squash and
# the depots are world-readable) and NFS speed (bulk reads measure 67 MB/s). SD just cannot drive a
# source agent over NFS — the same reason `swin` stages a depot before swinstall. This script
# therefore copies an NFS source to local disk beside the destination, copies from there, and
# removes the stage. Peak extra space needed = the size of the LARGEST single source.
#
# ⚠️ .tar/.tar.gz/.tgz ARCHIVES OF A DEPOT ARE UNPACKED AUTOMATICALLY. SD cannot read one directly
# (see is_depot below for the measured reason — it is the "./" member prefix). GNU tar is required
# and is looked up explicitly; HP tar would silently drop the long paths in a depot catalog.
#
# ⚠️ A SOURCE WHOSE PAYLOAD DOES NOT MATCH ITS CATALOG IS REFUSED (override with -F). See
# check_source below for what an incomplete source actually costs you.
#
# Env: DRYRUN=1  -> show what would run, copy nothing.
#      CUSTOMER_ID=, CODEWORD=  -> same as -c / -k

usage() {
  echo "usage: swmerge [-q] [-z] [-c <customer_id>] [-k <codeword>] <source-depot> [...] <destination-depot>"
  echo "       swmerge /mnt/debianshare/3rd_party_depots/* /depots/VendorAll"
  echo "       swmerge -c 3AYAJYGTCYGG -k \"RKZT WS-1 8VH1 QN/M\" /mnt/cdrom /depots/All"
  echo ""
  echo "  -c  customer ID from the CD certificate (or \$CUSTOMER_ID)"
  echo "  -k  codeword, quote it if it contains spaces (or \$CODEWORD)"
  echo "      Both are needed to copy licensed/protected products; without them those are skipped."
  echo "  -q  quiet: hide swcopy's per-fileset selection echo (~2400 lines on a full DVD) but KEEP"
  echo "      its analysis summary — the already-installed/skipped counts, plus any ERROR/WARNING."
  echo "  -z  report the exact depot size at the end (a du walk over a large depot takes MINUTES;"
  echo "      by default only the instant bdf filesystem figure is printed)."
  echo "  -F  force: merge a source even if its payload does not match its catalog. Off by default;"
  echo "      an incomplete source writes CORRUPT filesets into the destination that recopy=false"
  echo "      then skips forever, so the default is to refuse it."
  echo ""
  echo "  Sources may be directory depots, serial .depot files, or .tar/.tar.gz/.tgz archives of a"
  echo "  directory depot (extracted automatically — SD cannot read those directly)."
  exit 1
}

# Flags must precede the sources, which suits a glob (the glob is the positional tail).
CUST=${CUSTOMER_ID:-}
CW=${CODEWORD:-}
QUIET=""
FORCE=""
EXACTSIZE=""
while [ $# -gt 0 ] ; do
  case "$1" in
    -c) shift; CUST="$1"; shift ;;
    -k) shift; CW="$1"; shift ;;
    -q) QUIET=yes; shift ;;
    -F) FORCE=yes; shift ;;
    -z) EXACTSIZE=yes; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) echo "unknown option: $1"; usage ;;
    *) break ;;
  esac
done

# Build the codeword options once. Quoting matters: `-x "codeword=A B C D"` is ONE argument.
CWOPTS=""
if [ -n "$CW" ] || [ -n "$CUST" ] ; then
  if [ -z "$CW" ] || [ -z "$CUST" ] ; then
    echo "ERROR: -c and -k must be given together (a codeword is tied to a customer ID)."
    exit 1
  fi
  echo "using a codeword for customer ID $CUST (codeword supplied, not echoed)"
  echo ""
fi

# A source may be a directory depot (has catalog/), a serial .depot FILE (a tar archive that swcopy
# reads directly — what swpackage produces and what all our own depots are), or a .tar/.tar.gz/.tgz
# holding a directory depot that somebody archived.
#
# SD CANNOT read that last kind directly. Measured: `tar cf x.tar .` of a perfectly good directory
# depot gives "ERROR: The INDEX file on the source did not exist or could not be read". The cause is
# the "./" member prefix — SD wants a member named exactly catalog/INDEX:
#     tar cf x.tar catalog Product      -> swlist reads it
#     tar cf x.tar ./catalog ./Product  -> ERROR
#     tar cf x.tar .                    -> ERROR
# Member ORDER turned out not to matter; only the dot. Rather than make people re-tar, this script
# extracts a .tar source into the stage and merges the resulting directory.
is_depot() {
  [ -d "$1/catalog" ] && return 0
  [ -f "$1" ] || return 1
  case "$1" in
    *.tar|*.tar.gz|*.tgz) return 0 ;;   # validated after extraction, not by scanning GBs twice
    *.depot) ;;
    *) return 1 ;;
  esac
  N=`swlist -s "$1" -l product 2>/dev/null | grep -v '^#' | grep -v '^$' | wc -l`
  [ "$N" -gt 0 ]
}

is_tar() {
  case "$1" in *.tar|*.tar.gz|*.tgz) [ -f "$1" ] ;; *) return 1 ;; esac
}

[ $# -lt 2 ] && usage

# Split argv: last arg = destination, the rest = sources. Rotate through "$@" so paths containing
# spaces survive (HP-UX /usr/bin/sh has no arrays).
N=$#
DEST=""
i=0
while [ $i -lt $N ] ; do
  a="$1" ; shift
  i=`expr $i + 1`
  if [ $i -eq $N ] ; then DEST="$a" ; else set -- "$@" "$a" ; fi
done

[ -z "$DEST" ] && usage
case "$DEST" in -*) usage ;; esac

NONROOT=""
if [ "`id -u`" != "0" ] ; then
  if [ "$DEST" = "/var/spool/sw" ] ; then
    NONROOT=yes     # the only destination a non-root swcopy can actually reach
    echo "NOTE: running non-root — using swcopy's default /var/spool/sw target (no @)."
    echo "      Relocate it afterwards with a plain copy; the spool must start empty."
    echo ""
  else
    echo "ERROR: you are not root, so swcopy cannot write to '$DEST'."
    echo "       Measured: non-root 'swcopy ... @ <path>' fails with 'You do not have the required"
    echo "       permissions' — it copies nothing at all. Either run this as root, or pass"
    echo "       /var/spool/sw as the destination and relocate the result yourself."
    exit 1
  fi
fi

echo "destination: $DEST"
echo "sources:"
NSRC=0
for s in "$@" ; do
  if is_depot "$s" ; then
    if [ -f "$s" ] ; then echo "    $s  (serial .depot file)"
    else echo "    $s  (directory depot)" ; fi
    NSRC=`expr $NSRC + 1`
  else
    echo "    (skip, not an SD depot) $s"
  fi
done
[ "$NSRC" -eq 0 ] && { echo "no SD depots among the sources"; exit 1; }
echo ""

[ -d "$DEST" ] || mkdir -p "$DEST" || { echo "cannot create $DEST"; exit 1; }

# bdf prints the filesystem as host:/path for an NFS mount; local devices are /dev/vgNN/... and
# never contain a colon. (df -k on HP-UX prints a free-form report, not columns — do not parse it.)
is_nfs() {
  bdf "$1" 2>/dev/null | grep ":" > /dev/null 2>&1
}
avail_kb() {
  A=`bdf "$1" 2>/dev/null | tail -1 | awk '{print $4}'`
  case "$A" in ''|*[!0-9]*) A=0 ;; esac
  echo "$A"
}

# -q captures swcopy's stdout and replays only what matters. Not `-x verbose=0`: that is all-or-
# nothing (measured — verbose is a 0/1 switch, and passing 2 is silently accepted but changes
# nothing), so it would take the analysis counts and the ERROR/WARNING lines out along with the
# ~2400-line selection echo. Filtering keeps them.
# SD hard-wraps its messages, continuing them on a 9-space-indented line, which splits every count
# away from its own sentence. The sed loop rejoins a message onto one line before matching, so this
# does not depend on WHERE the wrap happens to fall (that moves with the target path length).
sd_summary() {
  sed -e ':a' -e '$!N' -e 's/\n         */ /' -e 'ta' -e 'P' -e 'D' "$1" \
    | egrep "already installed|to be skipped|Analysis and Execution (succeeded|failed)|^ERROR|^WARNING" \
    | sed -e 's/^ *\* *//' -e 's/^"[^"]*": *//' -e 's/^/    /'
}

# GNU tar, located explicitly. HP /usr/bin/tar must NOT be used to unpack a depot: its name field
# tops out at 100 chars (155 more only via the ustar prefix, and the LINK name field has no prefix
# at all), and depot catalog paths run well past that, so it drops files silently — the same class
# of damage as the Ignite pax truncation. Better to refuse than to unpack a depot with holes in it.
GTAR=""
for _t in /opt/gnu/bin/tar /usr/local/ia64/bin/tar ; do
  [ -x "$_t" ] && { GTAR=$_t ; break ; }
done

# Watch a background job fill up a directory. A 6 GB depot is ~11 min of silence otherwise, which is
# indistinguishable from a hang — and a hang is exactly what NFS+SD trained us to expect here.
watch_progress() {      # $1 dst   $2 total KB   $3 verb
  _dst=$1 ; _tot=$2 ; _verb=$3
  _t0=`date +%s`
  while kill -0 $CPPID 2>/dev/null ; do
    sleep 10
    kill -0 $CPPID 2>/dev/null || break
    _now=`du -sk "$_dst" 2>/dev/null | tail -1 | awk '{print $1}'`
    case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
    _el=`expr \`date +%s\` - $_t0` ; [ "$_el" -lt 1 ] && _el=1
    _pct=0 ; [ "$_tot" -gt 0 ] && _pct=`expr $_now \* 100 / $_tot`
    echo "    $_verb: `expr $_now / 1024` of `expr $_tot / 1024` MB (${_pct}%, `expr $_now / $_el / 1024` MB/s)"
  done
  wait $CPPID
  _rc=$?
  CPPID=""
  _el=`expr \`date +%s\` - $_t0` ; [ "$_el" -lt 1 ] && _el=1
  [ $_rc -eq 0 ] && echo "    $_verb done: `expr $_tot / 1024` MB in ${_el}s"
  return $_rc
}

stage_copy() {          # $1 src   $2 dst   $3 total KB
  if [ -d "$1" ] ; then cp -r "$1" "$2" & else cp "$1" "$2" & fi
  CPPID=$!
  watch_progress "$2" "$3" staging
}

# Unpack a .tar/.tar.gz/.tgz depot archive into the stage. The archive size is used as the progress
# total: for a plain .tar that is within a percent or two of the unpacked size; for a compressed one
# it under-counts, so the percentage runs past 100 rather than lying about being nearly finished.
stage_extract() {       # $1 archive   $2 dst   $3 archive size KB
  mkdir -p "$2" || return 1
  case "$1" in
    *.tar)  $GTAR xf  "$1" -C "$2" & ;;
    *)      $GTAR xzf "$1" -C "$2" & ;;
  esac
  CPPID=$!
  watch_progress "$2" "$3" extracting || return 1
  # Some archives wrap the depot in one top-level directory; descend into it so the caller always
  # gets a path that has catalog/ directly underneath.
  [ -d "$2/catalog" ] && return 0
  for _d in "$2"/* ; do
    [ -d "$_d/catalog" ] && { echo "    depot found at `basename \"$_d\"`/ inside the archive" ; TARSUB="$_d" ; return 0 ; }
  done
  echo "    no catalog/ anywhere in the archive — not an SD depot"
  return 1
}

# Refuse a source whose payload does not match its catalog. This is what the 2006 Applications DVD
# dump cost us on 2026-07-27: its catalog described 376 products but 55 had no payload directory at
# all, so swcopy hit 32446 "Cannot open source file" errors and left 105 CORRUPT filesets in the
# destination depot — which recopy=false will then happily skip forever. Every healthy depot on the
# share scores 0 missing, so this is a clean signal, not a heuristic. Only directories can be
# checked; a serial .depot would have to be unpacked to know.
check_source() {        # $1 = directory depot
  [ -d "$1/catalog" ] || return 0
  _tot=0 ; _miss=0 ; _ex=""
  for _p in "$1"/catalog/*/ ; do
    _p=`basename "$_p"`
    [ "$_p" = "dfiles" ] && continue
    _tot=`expr $_tot + 1`
    if [ ! -d "$1/$_p" ] ; then
      _miss=`expr $_miss + 1`
      [ $_miss -le 8 ] && _ex="$_ex $_p"
    fi
  done
  [ "$_miss" -eq 0 ] && { echo "    catalog check: $_tot products, all present" ; return 0 ; }
  echo "    catalog check: $_tot products, $_miss WITH NO PAYLOAD —$_ex ..."
  return 1
}

# One place that knows how to spell the swcopy call, so -q only has to redirect it.
run_swcopy() {          # $1 = source path
  if [ -n "$CW" ] ; then
    if [ -n "$NONROOT" ] ; then
      swcopy -s "$1" -x enforce_dependencies=false -x recopy=false \
             -x "codeword=$CW" -x "customer_id=$CUST" '*'
    else
      swcopy -s "$1" -x enforce_dependencies=false -x recopy=false \
             -x "codeword=$CW" -x "customer_id=$CUST" '*' @ "$DEST"
    fi
  else
    if [ -n "$NONROOT" ] ; then
      swcopy -s "$1" -x enforce_dependencies=false -x recopy=false '*'
    else
      swcopy -s "$1" -x enforce_dependencies=false -x recopy=false '*' @ "$DEST"
    fi
  fi
}

STAGEDIR=`dirname "$DEST"`
STAGE=""
CPPID=""
SWOUT=""
cleanup_stage() {
  [ -n "$CPPID" ] && kill $CPPID 2>/dev/null     # a staging cp still running
  CPPID=""
  [ -n "$STAGE" ] && rm -rf "$STAGE"
  STAGE=""
  [ -n "$SWOUT" ] && rm -f "$SWOUT"
  SWOUT=""
}
trap 'echo ""; echo "interrupted — removing local stage"; cleanup_stage; exit 130' 1 2 3 15

FAILED=""
for s in "$@" ; do
  is_depot "$s" || continue
  echo "=== swcopy `basename \"$s\"` ==="
  if [ -n "$DRYRUN" ] ; then
    if [ -n "$NONROOT" ] ; then
      echo "  DRYRUN: swcopy -s \"$s\" -x enforce_dependencies=false -x recopy=false${CW:+ -x codeword=<supplied> -x customer_id=$CUST} '*'   (default target /var/spool/sw)"
    else
      echo "  DRYRUN: swcopy -s \"$s\" -x enforce_dependencies=false -x recopy=false${CW:+ -x codeword=<supplied> -x customer_id=$CUST} '*' @ \"$DEST\""
    fi
    continue
  fi
  # A .tar archive always has to be unpacked (SD cannot read one), and an NFS source always has to
  # be copied local (SD cannot drive a source agent over NFS). Local directory depots and local
  # serial .depot files are used in place.
  SRC="$s"
  TARSUB=""
  if is_tar "$s" || is_nfs "$s" ; then
    if is_tar "$s" ; then
      [ -z "$GTAR" ] && {
        echo "  SKIP: no GNU tar found (/opt/gnu/bin/tar). HP tar truncates depot paths — refusing."
        FAILED="$FAILED `basename \"$s\"`(no-gnu-tar)"
        continue
      }
      NEED=`ls -l "$s" 2>/dev/null | awk '{print int($5/1024)}'`
    else
      NEED=`du -sk "$s" 2>/dev/null | tail -1 | awk '{print $1}'`
    fi
    case "$NEED" in ''|*[!0-9]*) NEED=0 ;; esac
    AVAIL=`avail_kb "$STAGEDIR"`
    # Room for the stage AND for what swcopy is about to write into the depot, plus the 2 GB floor.
    if [ "$AVAIL" -lt `expr $NEED + $NEED + 2097152` ] ; then
      echo "  SKIP: staging needs `expr $NEED / 1024` MB, only `expr $AVAIL / 1024` MB free on $STAGEDIR"
      FAILED="$FAILED `basename \"$s\"`(no-space)"
      continue
    fi
    STAGE=$STAGEDIR/.swmerge_stage.$$
    rm -rf "$STAGE"
    if is_tar "$s" ; then
      echo "  archived depot — unpacking `expr $NEED / 1024` MB with $GTAR (SD cannot read a .tar depot)"
      stage_extract "$s" "$STAGE" "$NEED"
    else
      echo "  NFS source — staging `expr $NEED / 1024` MB to local disk (SD cannot read a depot over NFS)"
      # cp -r, NOT tar: HP-UX tar's link-name field is a flat 100 chars and depot catalog paths run
      # past that, so a tar pipe silently drops files.
      stage_copy "$s" "$STAGE" "$NEED"
    fi
    if [ $? -eq 0 ] ; then
      SRC="$STAGE"
      [ -n "$TARSUB" ] && SRC="$TARSUB"
    else
      echo "  staging FAILED — skipping this source"
      cleanup_stage
      FAILED="$FAILED `basename \"$s\"`(stage)"
      continue
    fi
  fi
  # Catalog-vs-payload check. An incomplete source does not fail loudly — it writes corrupt filesets
  # into the destination that recopy=false then skips forever, so refuse it unless -F.
  if ! check_source "$SRC" ; then
    if [ -z "$FORCE" ] ; then
      echo "  SKIP: source is incomplete (pass -F to merge it anyway)"
      cleanup_stage
      FAILED="$FAILED `basename \"$s\"`(incomplete)"
      continue
    fi
    echo "    -F given — merging anyway; expect corrupt filesets in $DEST"
  fi
  # THE TARGET IS `@ <path>` — see the header. Non-root has no @ target available at all, so it
  # uses swcopy's default spool.
  # The codeword pair is passed only when supplied; SD then unlocks whatever on THIS source it
  # matches and still copies everything unprotected regardless.
  if [ -n "$QUIET" ] ; then
    SWOUT=$STAGEDIR/.swmerge_out.$$
    run_swcopy "$SRC" > "$SWOUT" 2>&1
    rc=$?
    sd_summary "$SWOUT"
    rm -f "$SWOUT" ; SWOUT=""
  else
    run_swcopy "$SRC"
    rc=$?
  fi
  cleanup_stage
  # SD returns 1 for warnings alone (unresolved cross-media dependencies are expected here), so a
  # non-zero rc is NOT proof of failure — report it and let the product count be the real check.
  [ $rc -ne 0 ] && { echo "  rc=$rc (SD warns with rc=1; check the count below)"; FAILED="$FAILED `basename \"$s\"`"; }
  N=`swlist -s "$DEST" -l product 2>/dev/null | grep -v '^#' | grep -v '^$' | wc -l`
  echo "  destination now holds $N product line(s)"
  # A full filesystem mid-copy corrupts the catalog; stop while the depot is still intact.
  # Use bdf, not df: HP-UX `df -k` prints a free-form "NNNN free allocated Kb" report rather than
  # columns, so the old `df | awk '{print $4}'` picked up the literal "Kb" and this guard never
  # once fired. bdf is the columnar one.
  FS=`avail_kb "$DEST"`
  if [ "$FS" -lt 2097152 ] ; then
    echo ""
    echo "STOPPING: under 2 GB free on the destination filesystem."
    echo "  The depot at $DEST is intact and usable; free space and rerun for the remaining sources."
    exit 2
  fi
done

# The loop already printed a running product total after every source, so for a SINGLE source this
# block used to repeat that number verbatim under a "=== result ===" heading that added nothing
# (Hugo caught it 2026-07-27). Only summarise when there was more than one source, where the grand
# total is genuinely new information.
if [ "$NSRC" -gt 1 ] ; then
  echo ""
  echo "=== result ==="
  swlist -s "$DEST" -l product 2>/dev/null | grep -v '^#' | grep -v '^$' | wc -l | sed 's/^/  products: /'
fi

# NO unconditional `du -sk "$DEST"` any more. On a 21 GB depot with ~2700 top-level entries that
# walk stats several hundred thousand files on one CPU: many minutes, no output, and it runs AFTER
# every copy has finished — so it looked exactly like a hang while buying nothing but a cosmetic
# number (reported 2026-07-27). bdf answers in milliseconds and, on a filesystem dedicated to
# depots, is within a fraction of a percent. Ask for the exact figure with -z when you want it.
FSU=`bdf "$DEST" 2>/dev/null | tail -1 | awk '{printf "%.1f", $3/1048576}'`
case "$FSU" in ''|*[!0-9.]*) FSU="" ;; esac
[ -n "$FSU" ] && echo "  `dirname \"$DEST\"` filesystem: ${FSU} GB used"
if [ -n "$EXACTSIZE" ] ; then
  echo "  measuring exact depot size — du over a depot this large takes minutes..."
  du -sk "$DEST" 2>/dev/null | awk '{printf "  size: %.2f GB\n", $1/1048576}'
fi

[ -n "$FAILED" ] && echo "  sources that reported non-zero rc (usually just warnings):$FAILED"
exit 0
