#!/usr/bin/sh
# build-status — one-glance state of the detached toolchain builds (sentinels, heartbeat, sizes).
DS=/mnt/debianshare/gnu_tarballs/driver_status
echo "== completion sentinels =="
for f in $DS/*.DONE ; do [ -f "$f" ] && { echo "-- `basename $f`:" ; cat "$f" ; } ; done
echo "" ; echo "== heartbeat ==" ; cat $DS/heartbeat.txt 2>/dev/null
echo "" ; echo "== build trees =="
du -sk /home/claude/build/gcc474-obj /home/claude/build/gcc485full-obj-via474 /home/claude/build/gcc485nb-obj 2>/dev/null
echo "" ; echo "== cascade log tail =="
tail -3 /home/claude/build/cascade_driver.log 2>/dev/null
