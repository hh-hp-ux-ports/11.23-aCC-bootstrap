#!/usr/bin/sh
# HelperScripts postinstall.
# SD does NOT delete files that disappear between revisions of a fileset — the swinstall man page
# explicitly lists that as a job for this script. 1.2 drops backup-vg00 (superseded by backup2tape,
# which does a real Ignite recovery tape and signals failure by leaving the tape loaded), so remove
# the stale copy here. Idempotent; must exit 0 or SD reports the fileset as having failed.
OBS=/opt/helpers/bin/backup-vg00
if [ -f "$OBS" ] ; then
  rm -f "$OBS" && echo "HelperScripts: removed obsolete $OBS (superseded by backup2tape)"
fi
exit 0
